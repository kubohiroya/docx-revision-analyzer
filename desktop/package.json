{
  "name": "docx-revision-analyzer-desktop",
  "productName": "Docx Revision Analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for docx-revision-analyzer: open a .docx and look back on how it was written.",
  "license": "MIT",
  "author": "Hiroya Kubo <kubo.hiroya@gmail.com>",
  "main": "dist/main.js",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node smoke.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/docx-revision-analyzer.git",
    "directory": "desktop"
  }
}
