{
  "name": "docx-revision-analyzer",
  "version": "1.2.0",
  "description": "Analyze Word (.docx) Track Changes history: chart edit activity over time, draw how paragraphs flow across editing sessions, and score suspiciously abrupt, paste-like insertions (possible AI-generated text). / 変更履歴(Track Changes)付きWordファイル(.docx)から、編集の時系列チャート・時間区間ごとの編集フローを描き、AI生成文の貼り付けを疑わせる不自然な挿入を検出するCLIツール群。",
  "license": "MIT",
  "author": "Hiroya Kubo <kubo.hiroya@gmail.com>",
  "keywords": [
    "docx",
    "word",
    "track-changes",
    "revision-history",
    "cli",
    "svg",
    "chart",
    "academic-integrity",
    "flow",
    "visualization",
    "ai-detection"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.19.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "bin": {
    "docx-revision-chart": "dist/cli/chart.js",
    "docx-ai-suspicion-score": "dist/cli/score.js",
    "docx-revision-flow": "dist/cli/flow.js",
    "docx-revision-snapshot": "dist/cli/snapshot.js",
    "docx-revision-versions": "dist/cli/versions.js"
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','release']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "node scripts/build-all.mjs",
    "build:lib": "tsc -p tsconfig.json",
    "build:cli": "node scripts/build-all.mjs --only=cli",
    "build:cli:all-platforms": "node scripts/build-all.mjs --only=cli --all-platforms",
    "build:droplet": "node scripts/build-all.mjs --only=droplet",
    "build:desktop": "node scripts/build-all.mjs --only=desktop",
    "build:desktop:installers": "node scripts/build-all.mjs --only=desktop --installers",
    "prepublishOnly": "npm run clean && npm run build:lib",
    "fixtures": "ts-node scripts/makeFixtures.ts",
    "diagrams": "node scripts/make-revision-states.mjs",
    "test": "node scripts/test-browser-bundle.mjs && node scripts/test-tamper-evidence.mjs && node scripts/test-track-lock.mjs && node scripts/test-snapshots.mjs && node scripts/test-versions.mjs && node scripts/test-page-layout.mjs && node scripts/test-comments.mjs && node scripts/test-watch.mjs",
    "test:comments": "node scripts/test-comments.mjs",
    "test:watch": "node scripts/test-watch.mjs",
    "test:layout": "node scripts/test-page-layout.mjs",
    "test:browser": "node scripts/test-browser-bundle.mjs",
    "test:tamper": "node scripts/test-tamper-evidence.mjs",
    "test:lock": "node scripts/test-track-lock.mjs",
    "test:snapshots": "node scripts/test-snapshots.mjs",
    "test:versions": "node scripts/test-versions.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/docx-revision-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/docx-revision-analyzer/issues"
  },
  "homepage": "https://github.com/kubohiroya/docx-revision-analyzer#readme"
}
