{
  "name": "docx-revision-analyzer",
  "version": "1.1.1",
  "description": "Analyze Word (.docx) Track Changes history: chart edit activity over time, draw how paragraphs flow across editing sessions, and score suspiciously abrupt, paste-like insertions (possible AI-generated text). / 変更履歴(Track Changes)付きWordファイル(.docx)から、編集の時系列チャート・時間区間ごとの編集フローを描き、AI生成文の貼り付けを疑わせる不自然な挿入を検出するCLIツール群。",
  "license": "MIT",
  "author": "Hiroya Kubo <kubo.hiroya@gmail.com>",
  "keywords": [
    "docx",
    "word",
    "track-changes",
    "revision-history",
    "cli",
    "svg",
    "chart",
    "academic-integrity",
    "flow",
    "visualization",
    "ai-detection"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "bin": {
    "docx-revision-chart": "dist/cli/chart.js",
    "docx-ai-suspicion-score": "dist/cli/score.js",
    "docx-revision-flow": "dist/cli/flow.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "fixtures": "ts-node scripts/makeFixtures.ts",
    "build:binary": "bash scripts/build-binary.sh chart",
    "build:binary:all": "bash scripts/build-binary.sh chart --all",
    "build:binary:score": "bash scripts/build-binary.sh score",
    "build:binary:flow": "bash scripts/build-binary.sh flow",
    "build:mac-app": "bash scripts/make-mac-droplet.sh chart",
    "build:mac-app:flow": "bash scripts/make-mac-droplet.sh flow",
    "test": "node scripts/test-browser-bundle.mjs",
    "test:browser": "node scripts/test-browser-bundle.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/docx-revision-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/docx-revision-analyzer/issues"
  },
  "homepage": "https://github.com/kubohiroya/docx-revision-analyzer#readme"
}
